<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set titulo %}{% block title %}Eventos{% endblock %}{% endset %}
    <title>{{ titulo|striptags|trim == 'Eventos' ? 'Eventos' : titulo|striptags|trim ~ ' · Eventos' }}</title>

    {% block stylesheets %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}{{ app.environment == 'dev' ? '?v=' ~ 'now'|date('U') : '' }}">
</head>

<body id="{% block pageid %}{% endblock %}">

<header>
    {% block header %}{% endblock %}
</header>

<main>
    {% for tipo, mensajes in app.flashes %}
        {% for message in mensajes %}
            <div class="alert alert-{{ tipo }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<footer>
    {% block footer %}{% endblock %}
    <div class="footer-copy">
        Gestion de eventos
    </div>
</footer>

{% block javascripts %}{% endblock %}

</body>
</html>