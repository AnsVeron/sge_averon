{% extends 'base.html.twig' %}
{% block header %}
    {% set ruta = app.request.attributes.get('_route') %}
    <h1><a href="{{ path('app_portada') }}">Gestión de Eventos</a></h1>

    <nav>
        <a href="{{ path('app_portada') }}"{% if ruta == 'app_portada' %} class="activo" aria-current="page"{% endif %}>Inicio</a>
        <a href="{{ path('app_eventos') }}"{% if ruta in ['app_eventos', 'app_evento_detalle', 'evento_disponibilidad'] %} class="activo" aria-current="page"{% endif %}>Eventos</a>
        <a href="{{ path('app_disertantes') }}"{% if ruta in ['app_disertantes', 'app_disertante_detalle'] %} class="activo" aria-current="page"{% endif %}>Disertantes</a>
        <span class="nav-usuario">
        {# iniciar sesion como administrador#}
        {% if app.user %}
            <a href="{{ path('admin_dashboard') }}">Panel</a>
            <a href="{{ path('app_logout') }}">Cerrar sesión</a>
        {% else %}
            <a href="{{ path('app_login') }}">Iniciar sesión</a>
        {% endif %}
        </span>
    </nav>
{% endblock %}
{% block body %}

<section>
    {% block contenido %}{% endblock %}
</section>

<aside>
    {% block lateral %}{% endblock %}
</aside>

{% endblock %}

{% block footer %}
    <div class="footer-contenido">
        <div class="footer-col">
            <h3>Eventos</h3>
            <p>Descubrí charlas y actividades, conocé a los disertantes y reservá tu lugar.</p>
        </div>

        <div class="footer-col">
            <h3>Navegación</h3>
            <ul>
                <li><a href="{{ path('app_portada') }}">Inicio</a></li>
                <li><a href="{{ path('app_eventos') }}">Eventos</a></li>
                <li><a href="{{ path('app_disertantes') }}">Disertantes</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h3>Información</h3>
            <ul>
                <li><a href="{{ path('app_estatica', {'pagina': 'condiciones'}) }}">Términos y condiciones</a></li>
                <li><a href="{{ path('app_estatica', {'pagina': 'privacidad'}) }}">Política de privacidad</a></li>
                <li><a href="{{ path('app_estatica', {'pagina': 'licencia'}) }}">Licencia</a></li>
                <li><a href="{{ path('app_estatica', {'pagina': 'patrocinadores'}) }}">Patrocinadores</a></li>
            </ul>
        </div>
    </div>
{% endblock %}