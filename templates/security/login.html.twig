{% extends 'base.html.twig' %}

{% block title %}Ingreso Administrador{% endblock %}

{% block body %}

    <div class="panel login">

        <h1>Gestión de Eventos</h1>
        <h2>Ingreso Administrador</h2>

        {% if error %}
            <div class="alert alert-danger">
                Credenciales incorrectas.
            </div>
        {% endif %}

        <form method="post">

            <div>
                <label for="username">Email</label>
                <input
                    type="email"
                    id="username"
                    name="_username"
                    value="{{ last_username }}"
                    required
                    autofocus
                >
            </div>

            <div>
                <label for="password">Contraseña</label>
                <input
                    type="password"
                    id="password"
                    name="_password"
                    required
                >
            </div>

            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit" class="btn btn-primary">
                Ingresar
            </button>

        </form>

    </div>

{% endblock %}
