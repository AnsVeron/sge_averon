{% extends 'frontend/layout.html.twig' %}

{% block title %}Disertantes{% endblock %}

{% block contenido %}

    <h1>Disertantes</h1>

    <div class="grid">
    {% for disertante in disertantes %}

        <div class="panel">

            <h2>
                <a href="{{ path('app_disertante_detalle', {'id': disertante.id}) }}">
                    {{ disertante.nombreCompleto }}
                </a>
            </h2>

            <p>{{ disertante.biografia }}</p>

            <p><strong>Imparte los siguientes eventos:</strong></p>

            <ul>
                {% for evento in disertante.eventos %}
                    <li>
                        <a href="{{ path('app_evento_detalle', {'slug': evento.slug}) }}">
                            {{ evento.titulo }}
                        </a>
                    </li>
                {% else %}
                    <li>No imparte ningún evento</li>
                {% endfor %}
            </ul>

            {% if disertante.twitter or disertante.linkedin %}
                <p>
                    <strong>Más información:</strong>
                    {% if disertante.twitter %}
                        <a href="{{ disertante.twitter }}">Twitter</a>
                    {% endif %}
                    {% if disertante.linkedin %}
                        <a href="{{ disertante.linkedin }}">LinkedIn</a>
                    {% endif %}
                </p>
            {% endif %}

        </div>

    {% endfor %}
    </div>

{% endblock %}
