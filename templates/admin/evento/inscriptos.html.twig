{% extends 'admin/evento/layout-admin.html.twig' %}

{% block title %}
    Inscriptos
{% endblock %}

{% block body %}

<div class="container mt-4">
    <a href="../listar" class="btn btn-secondary mb-3">
        Volver a Eventos
    </a>
    <h1>
        Inscriptos en el evento
        ({{ evento.usuarios|length }})
    </h1>

    <h4>
        {{ evento.titulo }}
    </h4>

    <hr>

    <table class="table table-bordered table-striped">

        <thead>
        <tr>
            <th>#</th>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Acciones</th>
        </tr>
        </thead>

        <tbody>

        {% for usuario in evento.usuarios %}

            <tr>

                <td>
                    {{ loop.index }}
                </td>

                <td>
                    {{ usuario.dni }}
                </td>

                <td>
                    {{ usuario.nombre }}
                    {{ usuario.apellido }}
                </td>

                <td>
                    {{ usuario.telefono }}
                </td>

                <td>
                    {{ usuario.email }}
                </td>

                <td>
                    <a href="{{ path('admin_evento_inscripto_eliminar', {id: evento.id, idUsuario: usuario.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('¿Está seguro que desea eliminar al usuario {{ usuario.nombre }} {{ usuario.apellido }} del evento?')">
                        Eliminar
                    </a>
                </td>

            </tr>

        {% else %}

            <tr>
                <td colspan="5">
                    No hay usuarios inscriptos.
                </td>
            </tr>

        {% endfor %}

        </tbody>

    </table>

</div>

{% endblock %}