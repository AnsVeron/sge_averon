{% extends 'base.html.twig' %}
{% block body %}
    <h1>{{ evento.titulo|title }}</h1>

    <p>{{ evento.descripcion|slice(0,150) }}</p>

    <div>
        <strong>Fecha:</strong>
        {{ evento.fecha|date('d/m/Y') }}
    </div>

    <div>
        <strong>Hora:</strong>
        {{ evento.hora|date('H:i') }}
        -
        {{ evento.horaFinalizacion|date('H:i') }}
    </div>

    <div>
        <strong>Idioma:</strong>
        {{ evento.idioma }}
    </div>

    <div>
        <strong>Disertante:</strong>
        <a href="{{ path('app_disertantes') }}">
            {{ evento.disertante }}
        </a>

    </div>

{% endblock %}