<!DOCTYPE html>
<html>
<head>
    <title>{% block title %}Eventos{% endblock %}</title>

    {% block stylesheets %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}{{ app.environment == 'dev' ? '?v=' ~ 'now'|date('U') : '' }}">
</head>

<body id="{% block pageid %}{% endblock %}">

<header>
    {% block header %}{% endblock %}
</header>

<main>
    {% for tipo, mensajes in app.flashes %}
        {% for message in mensajes %}
            <div class="alert alert-{{ tipo }}" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>

<footer>
    {% block footer %}{% endblock %}
</footer>

{% block javascripts %}{% endblock %}

</body>
</html>