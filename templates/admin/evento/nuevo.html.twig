{% extends 'admin/evento/layout-admin.html.twig' %}

{% block title %}
    Nuevo evento
{% endblock %}

{% block body %}

<div class="container mt-4">

    <h1>Nuevo evento</h1>

    <p>
        Complete los datos para registrar
        un nuevo evento en el sistema.
    </p>

    {{ form_start(form) }}

        {{ form_row(form.titulo) }}

        {{ form_row(form.descripcion) }}

        {{ form_row(form.fecha) }}

        {{ form_row(form.hora) }}

        {{ form_row(form.duracion) }}

        {{ form_row(form.idioma) }}

        {{ form_row(form.capacidad) }}

        {{ form_row(form.estado) }}

        {{ form_row(form.disertante) }}

        <button
            type="submit"
            class="btn btn-primary"
        >
            Guardar evento
        </button>

    {{ form_end(form) }}

</div>

{% endblock %}